# Copie para .env (cp .env.example .env) e ajuste. O .env não vai para o repositório.

# Porta do app: a MESMA no host (fora) e dentro do contêiner do frontend.
APP_PORT=8080

# Fuso horário (define "hoje" e "mês atual" no app).
TZ=America/Sao_Paulo

# 1 quando o acesso for por HTTPS (proxy/túnel na frente): o cookie de sessão passa a ser "Secure".
COOKIE_SECURE=0

# Só se houver outro proxy com outro nome na frente: host:porta aceitos nos POSTs (separados por vírgula).
ORIGENS_PERMITIDAS=

# Backups do banco (serviço db).
BACKUP_HORAS=24
BACKUP_RETENCAO_DIAS=30
BACKUP_MINIMO=7

# Avisos no Telegram (opcional; sem token/chat configurados, fica tudo desligado).
NOTIFICAR_DETALHES=1
GASTO_ALTO=500

# Só para testes: outros nomes de volume (para um ambiente de teste não tocar nos dados de produção).
# VOLUME_DADOS=controle-gastos-data
# VOLUME_BACKUPS=controle-gastos-backups
